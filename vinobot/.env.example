# Supabase (Project Settings > API Keys: usa la "secret key")
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Chiavi delle quattro AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Modelli: quando esce un modello nuovo si cambia solo qui, non il codice
# Criterio: i modelli che rispondono agli utenti dei piani gratuiti
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash
PERPLEXITY_MODEL=sonar
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# Modello che legge le risposte ed estrae le cantine
ESTRATTORE_MODEL=claude-haiku-4-5

# VinoBotte
VINOBOTTE_MODEL=claude-sonnet-5
RIASSUNTO_MODEL=claude-haiku-4-5
VINOBOTTE_URL=http://localhost:3000
